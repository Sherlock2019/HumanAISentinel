AI_PROVIDER=mock
# Launcher defaults: backend 8100, dashboard 5174.
# Override when launching: SENTINEL_API_PORT=8200 SENTINEL_UI_PORT=5274 ./start.sh
# The launcher reads port overrides from the shell environment, not this file.
TIMEZONE=Asia/Ho_Chi_Minh
# Local demo credential, not production authentication.
ADMIN_TOKEN=local-demo-admin
# DATABASE_URL=postgresql+psycopg://user:password@localhost/agentsentinel
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_URL=http://127.0.0.1:11434

# Intent Sentinel
# Number of recent session actions the Intent Engine considers.
INTENT_HISTORY_WINDOW=20
# false: a prediction alone escalates to human REVIEW, never to BLOCK.
# true: BLOCK also requires confidence >= 0.90, CRITICAL risk AND a deterministic sequence signal.
PREDICTIVE_BLOCKING=false
# Minimum confidence for a HIGH-RISK INTENT PREDICTED alert.
INTENT_ALERT_CONFIDENCE=0.80
# Weights for the non-hard-deny risk blend (normalised). An explicit DENY always wins.
# INTENT_RISK_WEIGHTS=policy=0.35,behavior=0.20,intent=0.25,resource=0.20
